# --- Required ---
# Shared secret: must equal CRON_AGENT_TOKEN on every agent.
CRON_SERVER_TOKEN=change-me-to-a-long-random-string

# --- Optional (defaults shown) ---
# SERVER_LISTEN=:8090
# DB_PATH=/data/cron-checker.db
# POLL_INTERVAL=300s
# POLL_CONCURRENCY=10
# POLL_TIMEOUT=15s
# AGENT_PORT=9300
# SNAPSHOT_RETENTION_DAYS=7
# LOG_LEVEL=info
